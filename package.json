{
  "name": "@cbh0920/dsh-client-ui-skin-arknights-amiya",
  "description": "Hot-pluggable Arknights Amiya / Rhodes Island PRTS skin for the DSH web GUI, optimized for a right-side coding workspace.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "verify:static": "node scripts/verify-static.mjs",
    "build:fallback": "node scripts/build-fallback.mjs",
    "test:node": "node scripts/verify-static.mjs --tests-only"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "README.md",
    "LICENSE"
  ]
}
